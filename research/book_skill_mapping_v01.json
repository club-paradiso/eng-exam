  "recommendation_rules":[
    {"rule_id":"GRAMMAR_FOUNDATION","if":"grammar_knowledge < 60","primary":"HONGONG_GRAMMAR_POS_2024","action":"weak Parts only; do not automatically restart book from Day 1"},
    {"rule_id":"KNOWLEDGE_PRODUCTION_GAP","if":"grammar_knowledge >= 70 AND productive_grammar_control < 65","primary":"HONGONG_SYNTAX_2024","secondary":"HONGONG_WRITING_2024","action":"reduce repetitive recognition questions; increase sentence generation"},
    {"rule_id":"GRAMMAR_SECURE","if":"grammar_knowledge >= 80 AND productive_grammar_control >= 75","primary":null,"action":"grammar book becomes review-only; shift lesson time to reading/writing/interaction"},
    {"rule_id":"READING_LOW","if":"reading A1 != secure","primary":"BRICKS_READING_100_NF_L1"},
    {"rule_id":"READING_MID","if":"reading A1 secure AND A2 emerging/developing","primary":"BRICKS_READING_100_NF_L2","secondary":"BRICKS_READING_100_NF_L3"},
    {"rule_id":"READING_HIGH","if":"E56_reading >= 85 AND reading_A2 == secure AND ceiling_positive","primary":"READING_INSIDE_STARTER_2022"},
    {"rule_id":"WRITING_LOW","if":"sentence_formation < 65 OR written_production <= A1 developing","primary":"HONGONG_WRITING_2024","secondary":"BAPPA_5_SENTENCES_WRITING_1"},
    {"rule_id":"WRITING_BRIDGE","if":"single_sentence >= 75 AND connected_writing < 70","primary":"BAPPA_5_SENTENCES_WRITING_1","secondary":"BAPPA_5_SENTENCES_WRITING_2"}
  ]
